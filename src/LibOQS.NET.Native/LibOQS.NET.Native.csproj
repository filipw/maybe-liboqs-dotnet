<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The raw bindings mirror liboqs names one-to-one (struct fields, algorithm identifier
         constants); documenting each of them individually would only repeat the name. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>LibOQS.NET.Native</PackageId>
    <PackageVersion>0.5.0</PackageVersion>
    <Authors>filipw</Authors>
    <Description>Native P/Invoke bindings for liboqs - a C library for quantum-resistant cryptographic algorithms</Description>
    <PackageProjectUrl>https://github.com/filipw/maybe-liboqs-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/filipw/maybe-liboqs-dotnet</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>quantum cryptography post-quantum liboqs</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every native library the published package must carry, keyed by runtime identifier.
         CI builds each one and drops it at this path before packing. -->
    <OqsNativeAsset Include="../native/runtimes/win-x64/native/oqs.dll" Rid="win-x64" />
    <OqsNativeAsset Include="../native/runtimes/win-arm64/native/oqs.dll" Rid="win-arm64" />
    <OqsNativeAsset Include="../native/runtimes/linux-x64/native/liboqs.so" Rid="linux-x64" />
    <OqsNativeAsset Include="../native/runtimes/linux-arm64/native/liboqs.so" Rid="linux-arm64" />
    <OqsNativeAsset Include="../native/runtimes/linux-musl-x64/native/liboqs.so" Rid="linux-musl-x64" />
    <OqsNativeAsset Include="../native/runtimes/osx-arm64/native/liboqs.dylib" Rid="osx-arm64" />

    <!-- The package redistributes liboqs binaries, so it carries the liboqs license too. -->
    <OqsLicenseFile Include="../../liboqs/LICENSE.txt" />

    <!-- Pack whichever of them are present. Local builds usually have at most the host's own
         library; ValidateNativeAssets below makes a release build insist on all of them. -->
    <None Include="@(OqsNativeAsset->Exists())" Pack="true" PackagePath="runtimes/%(Rid)/native/" Visible="false" />
    <None Include="@(OqsLicenseFile->Exists())" Pack="true" PackagePath="licenses/liboqs/" Visible="false" />
  </ItemGroup>

  <!-- Local development and testing: copy the library for the machine doing the build next to
       the assemblies. Prefer the runtime-specific location, and fall back to src/native, which
       is where the build-dotnet-liboqs scripts put their output by default. -->
  <PropertyGroup>
    <_OqsHostLibraryName Condition="$([MSBuild]::IsOsPlatform('Windows'))">oqs.dll</_OqsHostLibraryName>
    <_OqsHostLibraryName Condition="$([MSBuild]::IsOsPlatform('Linux'))">liboqs.so</_OqsHostLibraryName>
    <_OqsHostLibraryName Condition="$([MSBuild]::IsOsPlatform('OSX'))">liboqs.dylib</_OqsHostLibraryName>
    <_OqsHostLibrary>../native/runtimes/$(NETCoreSdkRuntimeIdentifier)/native/$(_OqsHostLibraryName)</_OqsHostLibrary>
    <_OqsHostLibrary Condition="!Exists('$(_OqsHostLibrary)')">../native/$(_OqsHostLibraryName)</_OqsHostLibrary>
  </PropertyGroup>

  <ItemGroup Condition="'$(_OqsHostLibraryName)' != '' And Exists('$(_OqsHostLibrary)')">
    <None Include="$(_OqsHostLibrary)" Link="$(_OqsHostLibraryName)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Without this, a platform whose native build silently produced nothing would simply be
       left out of the package. Release builds pass -p:RequireAllNativeAssets=true. -->
  <Target Name="ValidateNativeAssets" BeforeTargets="GenerateNuspec" Condition="'$(RequireAllNativeAssets)' == 'true'">
    <ItemGroup>
      <_OqsRequiredFile Include="@(OqsNativeAsset);@(OqsLicenseFile)" />
      <_OqsMissingFile Include="@(_OqsRequiredFile)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Error Condition="'@(_OqsMissingFile)' != ''" Text="Cannot pack $(PackageId): required files are missing: @(_OqsMissingFile, ', ')" />
  </Target>

</Project>
